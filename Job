# modelclass
from datetime import datetime

class Job:
    def __init__(self, job_id,description,priority,status,created_at,start_time,end_time,max_runtime,tags,failure_count,last_error_message,assigned_unit_id,retry_limit=0,retry_count=0 ):
        self.job_id=job_id
        self.description=description
        self.priority=priority
        self.status=status
        self.created_at = created_at or datetime.now()
        self.start_time=start_time
        self.end_time=end_time
        self.max_runtime=max_runtime
        self.tags=tags
        self.failure_count=failure_count
        self.last_error_message=last_error_message
        self.assigned_unit_id=assigned_unit_id
        self.retry_limit = retry_limit
        self.retry_count = retry_count

    #start time

    def startTime(self, currentTime):
        self.start_time = currentTime
        self.status = "RUNNING"


    #complete time
    def completeTime(self,endTime):
        self.end_time = endTime
        self.status = "COMPLETED"
    #fail
    def failedTimeCount(self,failureMessage):
        self.failure_count=self.failure_count+1
        self.last_error_message=failureMessage
        self.status = "FAILED"
    #has_timeout
    def maxTimeExceed(self,currentTime):
        runtime=currentTime-self.start_time
        return runtime>self.max_runtime

    def __str__(self):
        return f"Job(id={self.job_id}, description={self.description}, priority={self.priority}, status={self.status})"

